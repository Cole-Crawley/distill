# Local development: your own key, used straight from the browser.
# Never set this on a public deployment, because Vite bakes it into the bundle.
VITE_ANTHROPIC_API_KEY=your_key_here

# Hosted demo (set these in Vercel instead of the key above):
# VITE_USE_AI_RELAY=true      -> the app calls /api/anthropic
# ANTHROPIC_API_KEY=sk-ant-... -> read only by api/anthropic.ts on the server
